# copy this file to .streamlit/secrets.toml and fill in your own values
#   cp .streamlit/secrets.toml.example .streamlit/secrets.toml

[connections.postgresql]
dialect = "postgresql"
host = "localhost"
port = 5432
database = "your_database_name"
username = "your_username"
password = "your_password"

# optional background ingest settings (defaults shown)
# [ingest]
# sample_percent = 3
# keep_days = 7
# interval_minutes = 15
